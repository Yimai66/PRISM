# Copy this file to .env and fill in your keys.
 
# Search (Brave Search API — required for live multilingual search)
BRAVE_API_KEY=your_brave_search_api_key_here
 
# Translation (optional — DeepL. If left blank, mock translations from Case Book are used.)
DEEPL_API_KEY=
 
# LLM for disagreement detection.
# Provide AT LEAST ONE of the following two keys (Anthropic recommended — easier setup, free tier).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
 
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
 
# Provider selection: "auto" tries Anthropic first then OpenAI based on which key is present.
# Set to "anthropic" or "openai" to force one specifically.
LLM_PROVIDER=auto
 
# Mode switches
MOCK_MODE=false
USE_LIVE_SEARCH=true
USE_LIVE_TRANSLATION=false
USE_LIVE_LLM=true
